{
  "name": "@thinking-home/stm",
  "version": "0.0.1",
  "description": "Minimal state manager: stores, events, effects and keyed models, with all state kept in a scope",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "state",
    "store",
    "effects",
    "model",
    "react"
  ]
}
